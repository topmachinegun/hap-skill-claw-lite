      "alias": "owner",
      "type": "User",
      "required": true
    },
    {
      "name": "完成度",
      "alias": "progress",
      "type": "Number",
      "subType": 0,
      "required": false,
      "formula": true,
      "desc": "=AVG(子KR.完成度)，自动计算"
    },
    {
      "name": "状态",
      "alias": "status",
      "type": "Option",
      "required": true,
      "options": [
        {"key": "active", "value": "进行中"},
        {"key": "done", "value": "已完成"},
        {"key": "abandoned", "value": "已放弃"}
