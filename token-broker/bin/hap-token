#!/usr/bin/env python3
"""hap-token CLI 统一入口 —— 全局版本，不依赖任何工作区。

用法: hap-token <subcommand> [...]
"""
import sys
from pathlib import Path

# 全局 token-broker src 目录
_SRC = Path.home() / ".local" / "share" / "hap-token-broker" / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
